# Copiar a .env y ajustar valores

# Conexión a PostgreSQL
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/gestion_alumnos

# JWT
SECRET_KEY=cambiar-esta-clave-en-produccion-usar-string-aleatorio-largo
ACCESS_TOKEN_EXPIRE_MINUTES=480

# CORS — orígenes permitidos del frontend (separados por coma)
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000

# Datos que encabezan las boletas de pago (dejar vacío lo que no aplique)
EMPRESA_NOMBRE=Zarpemos
EMPRESA_RUC=
EMPRESA_DIRECCION=
EMPRESA_TELEFONO=
EMPRESA_EMAIL=
EMPRESA_LOGO_URL=https://zarpemos.online/assets/images/logo.jpg

# Base del link público de las boletas. Vacío = se deduce del request.
PUBLIC_BASE_URL=https://api.zarpemos.online
